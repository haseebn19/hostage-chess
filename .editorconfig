root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,js,jsx,mjs,ts,tsx,json,css,html}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Third-party files stay as they were published
[src/hostage_chess/static/vendor/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[src/hostage_chess/static/img/Chess_Pieces_Sprite.svg]
insert_final_newline = unset
trim_trailing_whitespace = unset
